<Window x:Class="Minesweeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Rules: left click opens a cell, right click flags cell, you should open all safe cells to win"
                       TextWrapping="Wrap"
                       Margin="40,0,0,5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Easy" Width="80" Margin="4" Click="EasyClick"/>
                <Button Content="Medium" Width="80" Margin="4" Click="MediumClick"/>
                <Button Content="Hard" Width="80" Margin="4" Click="HardClick"/>
                <Button Content="Restart" Width="80" Margin="4" Click="RestartClick"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                <TextBlock x:Name="timerText" Text="Time: 0" FontSize="16" Margin="15,0"/>
                <TextBlock x:Name="minesLeftText" Text="Mines left: 10" FontSize="16" Margin="15,0"/>
                <TextBlock x:Name="livesText" Text="Lives: 3" FontSize="16" Margin="15,0"/>
            </StackPanel>
        </StackPanel>
        <UniformGrid Grid.Row="1" x:Name="gameGrid" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
